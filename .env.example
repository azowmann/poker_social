# Copy to .env and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both are safe to expose in the app bundle: they identify the project, they do
# not grant access. Row Level Security decides what a caller may read or write.
# EXPO_PUBLIC_* is inlined at BUILD time, so restart the dev server after editing.
#
# Never put the service_role key here - it bypasses RLS and must not ship.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
